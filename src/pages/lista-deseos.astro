---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { productos } from '../data/productos';
import { WHATSAPP_PRINCIPAL } from '../data/site';
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Lista de deseos"
  description="Las prendas Nancy que guardaste. Envíanos tu lista por WhatsApp y coordinamos talla, pago y entrega."
>
  <section class="max-w-6xl mx-auto px-6 py-20 md:py-28">
    <header class="text-center mb-12">
      <h1 class="text-4xl md:text-6xl font-medium text-[var(--color-black)] mb-4">Lista de deseos</h1>
      <p class="text-[var(--color-gray)]">
        Las prendas que guardaste se quedan en este navegador. No necesitas registrarte.
      </p>
    </header>

    <div data-lista-vacia class="text-center py-16">
      <p class="text-[var(--color-gray)] mb-6">Todavía no guardaste ninguna prenda.</p>
      <a
        href={`${base}catalogo`}
        class="inline-block px-8 py-4 bg-[var(--color-burgundy)] text-white text-sm tracking-widest uppercase hover:bg-[var(--color-burgundy-hover)] transition-colors"
      >
        Ver catálogo
      </a>
    </div>

    <div data-lista-contenido class="hidden">
      <div class="grid grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-10">
        {productos.map((producto) => (
          <div data-item={producto.slug} class="hidden">
            <ProductCard producto={producto} />
          </div>
        ))}
      </div>

      <div class="mt-16 text-center">
        <a
          href="#"
          data-wa-lista
          data-numero={WHATSAPP_PRINCIPAL}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-8 py-4 bg-[var(--color-burgundy)] text-white text-sm tracking-widest uppercase hover:bg-[var(--color-burgundy-hover)] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" />
          </svg>
          Enviar lista por WhatsApp
        </a>
        <p class="text-sm text-[var(--color-gray)] mt-3">
          Te respondemos para coordinar talla, pago y entrega.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { getLista } from '../scripts/wishlist';

  const vacia = document.querySelector<HTMLElement>('[data-lista-vacia]');
  const contenido = document.querySelector<HTMLElement>('[data-lista-contenido]');
  const wa = document.querySelector<HTMLAnchorElement>('[data-wa-lista]');

  const render = (slugs: string[]) => {
    const nombres: string[] = [];
    document.querySelectorAll<HTMLElement>('[data-item]').forEach((item) => {
      const visible = slugs.includes(item.dataset.item || '');
      item.classList.toggle('hidden', !visible);
      if (visible) {
        const nombre = item.querySelector<HTMLElement>('[data-nombre]')?.textContent?.trim();
        if (nombre) nombres.push(nombre);
      }
    });

    vacia?.classList.toggle('hidden', nombres.length > 0);
    contenido?.classList.toggle('hidden', nombres.length === 0);

    if (wa && nombres.length > 0) {
      const mensaje =
        'Hola Nancy, me interesan estas prendas:\n' +
        nombres.map((n, i) => `${i + 1}. ${n}`).join('\n') +
        '\n¿Están disponibles? ¿Qué tallas tienen?';
      wa.href = `https://wa.me/${wa.dataset.numero}?text=${encodeURIComponent(mensaje)}`;
    }
  };

  document.addEventListener('lista:render', (e) => render((e as CustomEvent<string[]>).detail));
  render(getLista());
</script>
