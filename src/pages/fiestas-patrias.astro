---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { productosPorCategoria } from '../data/productos';

const base = import.meta.env.BASE_URL;
const vestidos = productosPorCategoria('fiestas-patrias');
const accesorios = productosPorCategoria('accesorios');

const WHATSAPP_NUMBER = '56983878181';
const msg = encodeURIComponent('Hola Nancy, quiero información sobre los vestidos de huasa para Fiestas Patrias 🇨🇱');
const waLink = `https://wa.me/${WHATSAPP_NUMBER}?text=${msg}`;
---

<BaseLayout
  title="Fiestas Patrias"
  description="Vestidos de huasa para Fiestas Patrias, confeccionados en Puerto Montt. Reserva el tuyo por WhatsApp."
  image={base + 'images/productos/fiestas-patrias/PORTADA.jpg'}
>
  <!-- Hero -->
  <section class="relative">
    <div class="aspect-[16/10] md:aspect-[16/6] overflow-hidden">
      <img
        src={base + 'images/productos/fiestas-patrias/PORTADA.jpg'}
        alt="Vestidos de huasa Nancy"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 text-center">
      <p class="text-sm tracking-widest uppercase text-[var(--color-burgundy)] mb-4">🇨🇱 Septiembre 🎉🎊</p>
      <h1 class="text-4xl md:text-7xl font-medium text-[var(--color-black)] mb-6">Fiestas Patrias</h1>
      <p class="text-lg text-[var(--color-gray)] max-w-2xl mx-auto leading-relaxed mb-8">
        Vestidos de huasa confeccionados en nuestro taller en Puerto Montt. En tu color y tu talla,
        hechos para cuerpos reales. Reserva el tuyo antes de que se acabe la temporada.
      </p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="inline-block px-8 py-3 bg-[var(--color-burgundy)] text-white text-sm tracking-widest uppercase hover:bg-[var(--color-burgundy-hover)] transition-colors"
      >
        Reservar por WhatsApp
      </a>
    </div>
  </section>

  <!-- Vestidos -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <h2 class="text-2xl md:text-3xl font-medium text-[var(--color-black)] mb-8">Vestidos de huasa</h2>
    <ProductGrid productos={vestidos} />
  </section>

  {accesorios.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-24">
      <h2 class="text-2xl md:text-3xl font-medium text-[var(--color-black)] mb-8">Complementos</h2>
      <ProductGrid productos={accesorios} />
    </section>
  )}

  <!-- CTA -->
  <section class="bg-[var(--color-burgundy)] text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="text-2xl md:text-4xl font-medium mb-4">¿Dudas con tu talla o color?</h2>
      <p class="opacity-90 mb-8 max-w-xl mx-auto">También confeccionamos a medida. Escríbenos y te ayudamos a elegir.</p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="inline-block px-8 py-3 bg-white text-[var(--color-burgundy)] text-sm tracking-widest uppercase hover:bg-[var(--color-cream)] transition-colors"
      >
        Escríbenos
      </a>
    </div>
  </section>
</BaseLayout>
