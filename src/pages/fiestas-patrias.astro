---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { productosPorCategoria } from '../data/productos';
import { waLink as buildWaLink } from '../data/site';

const base = import.meta.env.BASE_URL;
const fiestasPatrias = productosPorCategoria('fiestas-patrias');
const vestidos = fiestasPatrias.filter((p) => p.slug !== 'enagua-can-can');
const complementos = fiestasPatrias.filter((p) => p.slug === 'enagua-can-can');

const waLink = buildWaLink('Hola Nancy, quiero información sobre los vestidos de huasa/china');
---

<BaseLayout
  title="Vestidos de Huasa y China"
  description="Vestidos de huasa y china confeccionados en Puerto Montt, para Fiestas Patrias, actos de colegio o peñas. A tu medida."
  image={base + 'images/portadas/fiestas-patrias.jpg'}
>
  <!-- Hero -->
  <section class="relative">
    <div class="aspect-[16/10] md:aspect-[16/6] overflow-hidden">
      <img
        src={base + 'images/portadas/fiestas-patrias.jpg'}
        alt="Vestidos de huasa Nancy"
        class="w-full h-full object-cover"
      />
    </div>
    <div class="max-w-6xl mx-auto px-6 py-12 md:py-16 text-center">
      <p class="text-sm tracking-widest uppercase text-[var(--color-burgundy)] mb-4">🇨🇱 Vestidos de huasa y china</p>
      <h1 class="text-4xl md:text-7xl font-medium text-[var(--color-black)] mb-6">Fiestas Patrias</h1>
      <p class="text-lg text-[var(--color-gray)] max-w-2xl mx-auto leading-relaxed mb-8">
        Vestidos de huasa y china confeccionados en nuestro taller en Puerto Montt. En tu color y tu
        talla, hechos para cuerpos reales. Ideales para el 18, actos de colegio, peñas o bailar cueca.
      </p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="inline-block px-8 py-3 bg-[var(--color-burgundy)] text-white text-sm tracking-widest uppercase hover:bg-[var(--color-burgundy-hover)] transition-colors"
      >
        Consultar por WhatsApp
      </a>
    </div>
  </section>

  <!-- Vestidos -->
  <section class="max-w-6xl mx-auto px-6 pb-16">
    <h2 class="text-2xl md:text-3xl font-medium text-[var(--color-black)] mb-8">Vestidos de huasa</h2>
    <ProductGrid productos={vestidos} />
  </section>

  {complementos.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-24">
      <h2 class="text-2xl md:text-3xl font-medium text-[var(--color-black)] mb-8">Complementos</h2>
      <ProductGrid productos={complementos} />
    </section>
  )}

  <!-- CTA -->
  <section class="bg-[var(--color-burgundy)] text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="text-2xl md:text-4xl font-medium mb-4">¿Dudas con tu talla o color?</h2>
      <p class="opacity-90 mb-8 max-w-xl mx-auto">También confeccionamos a medida. Escríbenos y te ayudamos a elegir.</p>
      <a
        href={waLink}
        target="_blank"
        rel="noopener"
        class="inline-block px-8 py-3 bg-white text-[var(--color-burgundy)] text-sm tracking-widest uppercase hover:bg-[var(--color-cream)] transition-colors"
      >
        Escríbenos
      </a>
    </div>
  </section>
</BaseLayout>
