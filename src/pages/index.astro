---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { productoPorSlug } from '../data/productos';
import { waLink as buildWaLink } from '../data/site';

const base = import.meta.env.BASE_URL;
const waLink = buildWaLink('Hola Nancy, me gustaría consultar sobre sus prendas');
const destacadosSlugs = [
  'vestido-china-rojo-hojas',
  'tenida-huasa-elegante',
  'vestido-china-negro-flores',
  'abrigo-jacquard-damasco',
  'conjunto-traje-negro',
  'conjunto-hojas-chaqueta-rosa',
];
const destacados = destacadosSlugs.map((slug) => productoPorSlug(slug)!);
---

<BaseLayout title="Inicio" description="Nancy — Ropa de confección nacional para mujeres. Puerto Montt, Chile.">
  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-6 py-12 md:py-16 text-center">
    <img
      src={base + 'images/marca/Nancy-Hero.png'}
      alt="Nancy — Confección Nacional"
      class="h-20 md:h-28 mx-auto object-contain mb-10"
    />
    <h1 class="text-5xl md:text-7xl font-medium text-[var(--color-black)] mb-6">Hecho para ti</h1>
    <p class="text-lg text-[var(--color-gray)] mb-10 max-w-xl mx-auto leading-relaxed">
      Prendas de confección nacional. Diseñadas y elaboradas en Puerto Montt.
    </p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href={`${base}catalogo`} class="px-8 py-3 bg-[var(--color-burgundy)] text-white text-sm tracking-widest uppercase hover:bg-[var(--color-burgundy-hover)] transition-colors">
        Ver catálogo
      </a>
      <a href={waLink} target="_blank" rel="noopener" class="px-8 py-3 border border-[var(--color-burgundy)] text-[var(--color-burgundy)] text-sm tracking-widest uppercase hover:bg-[var(--color-burgundy)] hover:text-white transition-colors">
        Escríbenos
      </a>
    </div>
  </section>

  <!-- Banner Fiestas Patrias -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <a href={`${base}fiestas-patrias`} class="group block relative overflow-hidden border border-[var(--color-gray-lt)]">
      <div class="aspect-[16/9] md:aspect-[16/6] overflow-hidden">
        <img
          src={base + 'images/productos/fiestas-patrias/PORTADA.jpg'}
          alt="Vestidos de huasa para Fiestas Patrias"
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
      </div>
      <div class="absolute inset-0 bg-black/30 flex flex-col items-center justify-center text-center text-white px-6">
        <p class="text-sm tracking-widest uppercase mb-2">Septiembre 🇨🇱</p>
        <h2 class="text-3xl md:text-5xl font-medium mb-3">Fiestas Patrias</h2>
        <p class="text-sm md:text-base mb-5 max-w-md">Vestidos de huasa hechos en Puerto Montt. Reserva el tuyo.</p>
        <span class="px-6 py-2 bg-white text-[var(--color-burgundy)] text-sm tracking-widest uppercase">Ver colección</span>
      </div>
    </a>
  </section>

  <!-- Servicios -->
  <section class="max-w-6xl mx-auto px-6 pb-20">
    <h2 class="text-3xl md:text-4xl font-medium text-[var(--color-black)] text-center mb-12">Nuestros servicios</h2>
    <div class="grid sm:grid-cols-3 gap-6">
      <div class="border border-[var(--color-gray-lt)] p-8 text-center">
        <p class="text-sm tracking-widest uppercase text-[var(--color-burgundy)] mb-3">Envíos</p>
        <p class="text-[var(--color-gray)] leading-relaxed">Realizamos envíos para que recibas tu prenda donde estés.</p>
      </div>
      <div class="border border-[var(--color-gray-lt)] p-8 text-center">
        <p class="text-sm tracking-widest uppercase text-[var(--color-burgundy)] mb-3">Confección a medida</p>
        <p class="text-[var(--color-gray)] leading-relaxed">Confeccionamos a tu medida, en tu color y tu talla.</p>
      </div>
      <div class="border border-[var(--color-gray-lt)] p-8 text-center">
        <p class="text-sm tracking-widest uppercase text-[var(--color-burgundy)] mb-3">Visitas a instituciones</p>
        <p class="text-[var(--color-gray)] leading-relaxed">Vamos dentro de la provincia a tomar medidas a colegios, iglesias evangélicas e instituciones.</p>
      </div>
    </div>
  </section>

  <!-- Destacados -->
  {destacados.length > 0 && (
    <section class="max-w-6xl mx-auto px-6 pb-20">
      <h2 class="text-3xl md:text-4xl font-medium text-[var(--color-black)] text-center mb-12">Destacados</h2>
      <ProductGrid productos={destacados} />
    </section>
  )}

  <!-- CTA final -->
  <section class="bg-[var(--color-burgundy)] text-white">
    <div class="max-w-6xl mx-auto px-6 py-16 text-center">
      <h2 class="text-2xl md:text-4xl font-medium mb-4">¿Tienes dudas sobre tallas?</h2>
      <p class="opacity-90 mb-8 max-w-xl mx-auto">Escríbenos por WhatsApp y te ayudamos a elegir la prenda perfecta.</p>
      <a href={waLink} target="_blank" rel="noopener" class="inline-block px-8 py-3 bg-white text-[var(--color-burgundy)] text-sm tracking-widest uppercase hover:bg-[var(--color-cream)] transition-colors">
        Escríbenos
      </a>
    </div>
  </section>
</BaseLayout>
