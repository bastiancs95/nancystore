---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ProductGallery from '../../components/ProductGallery.astro';
import WishlistButton from '../../components/WishlistButton.astro';
import { productos, productosPorCategoria } from '../../data/productos';
import { waLink as buildWaLink } from '../../data/site';

export function getStaticPaths() {
  return productos.map((producto) => ({
    params: { slug: producto.slug },
    props: { producto },
  }));
}

const { producto } = Astro.props;
const base = import.meta.env.BASE_URL;
const tallas = producto.tallas ?? ['S', 'M', 'L', 'XL', '2XL'];

const waLink = buildWaLink(
  `Hola Nancy, me interesa el producto "${producto.nombre}". ¿Está disponible? ¿Qué tallas tienen?`,
);

const relacionados = productosPorCategoria(producto.categoria)
  .filter((p) => p.slug !== producto.slug)
  .slice(0, 3);
---

<BaseLayout title={producto.nombre} description={producto.descripcion} image={base + producto.imagenes[0]}>
  <section class="max-w-6xl mx-auto px-6 py-16 md:py-24">
    <a href={`${base}catalogo`} class="text-sm text-[var(--color-gray)] hover:text-[var(--color-burgundy)] transition-colors">
      ← Volver al catálogo
    </a>

    <div class="grid md:grid-cols-2 gap-10 md:gap-16 mt-8">
      <!-- Galería -->
      <ProductGallery imagenes={producto.imagenes} nombre={producto.nombre} />

      <!-- Info -->
      <div class="md:sticky md:top-24 md:self-start">
        {producto.nuevo && (
          <span class="text-xs tracking-widest uppercase text-[var(--color-burgundy)]">Nuevo</span>
        )}
        <h1 class="text-3xl md:text-5xl font-medium text-[var(--color-black)] mt-1 mb-6">{producto.nombre}</h1>
        <p class="text-base leading-relaxed text-[var(--color-gray)] mb-8">{producto.descripcion}</p>

        <div class="mb-8">
          <p class="text-sm tracking-widest uppercase text-[var(--color-gray)] mb-3">Tallas</p>
          <div class="flex flex-wrap gap-2">
            {tallas.map((t) => (
              <span class="px-4 py-2 text-sm border border-[var(--color-gray-lt)] text-[var(--color-black)]">{t}</span>
            ))}
          </div>
        </div>

        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 w-full justify-center px-8 py-4 bg-[var(--color-burgundy)] text-white text-sm tracking-widest uppercase hover:bg-[var(--color-burgundy-hover)] transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884" />
          </svg>
          Consultar por WhatsApp
        </a>
        <WishlistButton slug={producto.slug} variante="completo" />
        <p class="text-sm text-[var(--color-gray)] mt-3 text-center">Te respondemos para coordinar talla, pago y entrega.</p>
      </div>
    </div>

    {relacionados.length > 0 && (
      <div class="mt-24">
        <h2 class="text-2xl md:text-3xl font-medium text-[var(--color-black)] mb-8">También te puede gustar</h2>
        <ProductGrid productos={relacionados} />
      </div>
    )}
  </section>
</BaseLayout>
