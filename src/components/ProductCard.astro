---
import type { Producto } from '../data/productos';
import WishlistButton from './WishlistButton.astro';
const { producto } = Astro.props as { producto: Producto };
const base = import.meta.env.BASE_URL;
const href = `${base}catalogo/${producto.slug}`;
const img = base + producto.imagenes[0];
---

<div class="group relative" data-categoria={producto.categoria} data-producto={producto.slug}>
  <WishlistButton slug={producto.slug} />
  <a href={href} class="block">
    <div class="aspect-[3/4] overflow-hidden bg-[var(--color-white)] border border-[var(--color-gray-lt)]">
      <img
        src={img}
        alt={producto.nombre}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
      />
    </div>
    <div class="mt-3">
      {producto.nuevo && (
        <span class="text-xs tracking-widest uppercase text-[var(--color-burgundy)]">Nuevo</span>
      )}
      <h3 class="brand text-lg text-[var(--color-black)] leading-snug" data-nombre>{producto.nombre}</h3>
      <p class="text-sm text-[var(--color-gray)] mt-1">Consultar por WhatsApp</p>
    </div>
  </a>
</div>
